# Vorlage. Echte Werte gehören in .env.local (gitignored, niemals committen).
# Tipp: `npm run keys` erzeugt .env.local automatisch mit frischen VAPID-Keys.

# Datenbank. Lokal eine Datei, in Produktion (Vercel) eine Turso-DB.
# TURSO_DATABASE_URL=libsql://<db>.turso.io
# TURSO_AUTH_TOKEN=<token>

# Web-Push (VAPID). Public Key geht auch an den Client.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:stufe@example.org

# Beispieldaten beim Start erzeugen? (true = Demo-Inhalte, sonst leer)
# SP_SEED=true
