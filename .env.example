# Vorlage. Echte Werte gehören in .env.local (gitignored, niemals committen).
# Tipp: `npm run keys` erzeugt .env.local automatisch mit frischen VAPID-Keys + Secret.

# Sprecher-/Admin-Code: schaltet in "Mehr → Sprecher-Modus" die Verwaltung frei.
ADMIN_CODE=stufe2026

# Signier-Secret für Admin-Cookie & anonyme Stimm-Hashes (zufälliger Hex-String).
SP_SECRET=change-me-zufaelliger-hex-string

# Web-Push (VAPID). Public Key geht auch an den Client.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:stufe@example.org

# Beispieldaten beim Start erzeugen? (true = Demo-Inhalte, sonst leer)
# SP_SEED=true
